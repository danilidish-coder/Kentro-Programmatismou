<Application x:Class="KentroOffline.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Application.Resources>
  <SolidColorBrush x:Key="BackgroundBrush" Color="#081A2A"/>
  <SolidColorBrush x:Key="CardBrush" Color="#103451"/>
  <SolidColorBrush x:Key="FieldBrush" Color="#0A273F"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#25A5DC"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F0F8FF"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#B6D5E7"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#1B557B"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#4A9ECC"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,8"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="MinHeight" Value="39"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
       <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#2679A3"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value=".48"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <!-- Explicit dark tab headers: native Windows themes may otherwise draw pale
       header text on a pale selected/unselected tab background. -->
  <Style TargetType="TabItem">
   <Setter Property="Background" Value="#153B57"/>
   <Setter Property="Foreground" Value="#F8FBFF"/>
   <Setter Property="BorderBrush" Value="#4B83A8"/>
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="14,11"/>
   <Setter Property="Margin" Value="2,0,3,0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="TabHeaderBorder"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="1,1,1,0"
        CornerRadius="7,7,0,0"
        Padding="{TemplateBinding Padding}">
       <TextBlock x:Name="TabHeaderText"
         Text="{TemplateBinding Header}"
         Foreground="{TemplateBinding Foreground}"
         FontFamily="{TemplateBinding FontFamily}"
         FontSize="{TemplateBinding FontSize}"
         FontWeight="{TemplateBinding FontWeight}"
         TextTrimming="None"
         TextWrapping="NoWrap"
         HorizontalAlignment="Center"
         VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="TabHeaderBorder" Property="Background" Value="#276B92"/>
        <Setter TargetName="TabHeaderBorder" Property="BorderBrush" Value="#91C7E5"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="TabHeaderBorder" Property="Background" Value="#245E81"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="TabHeaderBorder" Property="Opacity" Value="0.7"/>
        <Setter Property="Foreground" Value="#E5EEF4"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="CaretBrush" Value="White"/>
   <Setter Property="BorderBrush" Value="#2C759B"/>
   <Setter Property="Padding" Value="8"/>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="BorderBrush" Value="#2C759B"/>
   <Setter Property="Padding" Value="6"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
 </Application.Resources>
</Application>