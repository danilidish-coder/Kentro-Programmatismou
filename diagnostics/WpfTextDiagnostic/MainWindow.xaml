<Window x:Class="KentroTextDiagnostic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Έλεγχος καθαρότητας γραμμάτων — WPF"
        Width="1100" Height="690" MinWidth="850" MinHeight="570"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Background="#071724" Foreground="#F4F9FF"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="DiagnosticButton" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0B629C"/>
            <Setter Property="BorderBrush" Value="#329FE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B4E6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#084D83"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ΔΟΚΙΜΗ ΚΑΘΑΡΟΤΗΤΑΣ ΓΡΑΜΜΑΤΩΝ" FontSize="27"
                       FontWeight="Bold" Foreground="#F4F9FF"/>
            <TextBlock Text="Μόνο διαγνωστικό παράθυρο WPF · δεν αλλάζει κανένα πρόγραμμα ή αρχείο σας"
                       Foreground="#B8D1E4" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0B3046" BorderBrush="#226A93"
                    BorderThickness="1" CornerRadius="12" Padding="20"
                    TextOptions.TextRenderingMode="ClearType"
                    TextOptions.TextHintingMode="Fixed">
                <StackPanel>
                    <TextBlock Text="Α — WPF ClearType" FontSize="19" FontWeight="Bold"
                               Foreground="#51BEFF" Margin="0,0,0,20"/>
                    <TextBlock Text="ΚΕΝΤΡΟ ΠΡΟΓΡΑΜΜΑΤΙΣΜΟΥ" FontSize="25"
                               FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Καταγραφή Θέσεων" FontSize="22"
                               FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Έκδοση v1.2.5 · 17 λειτουργικοί έλεγχοι · 4 δοκιμές πίεσης"
                               FontSize="13" Foreground="#C5D8E5"
                               TextWrapping="Wrap" Margin="0,0,0,22"/>
                    <TextBlock Text="ΕΛΕΓΧΟΙ   ΑΝΑΦΟΡΑ   ΚΑΤΑΣΚΕΥΗ EXE"
                               FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Επόμενο βήμα: λειτουργικοί έλεγχοι και stress tests"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="#BDD4E7" Margin="0,0,0,24"/>
                    <Button Style="{StaticResource DiagnosticButton}"
                            Content="ΔΟΚΙΜΗ ΚΟΥΜΠΙΟΥ" Tag="Α — ClearType"
                            Click="TestButton_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#0B3046" BorderBrush="#226A93"
                    BorderThickness="1" CornerRadius="12" Padding="20"
                    TextOptions.TextRenderingMode="Grayscale"
                    TextOptions.TextHintingMode="Fixed">
                <StackPanel>
                    <TextBlock Text="Β — WPF Grayscale" FontSize="19" FontWeight="Bold"
                               Foreground="#51BEFF" Margin="0,0,0,20"/>
                    <TextBlock Text="ΚΕΝΤΡΟ ΠΡΟΓΡΑΜΜΑΤΙΣΜΟΥ" FontSize="25"
                               FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Καταγραφή Θέσεων" FontSize="22"
                               FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Έκδοση v1.2.5 · 17 λειτουργικοί έλεγχοι · 4 δοκιμές πίεσης"
                               FontSize="13" Foreground="#C5D8E5"
                               TextWrapping="Wrap" Margin="0,0,0,22"/>
                    <TextBlock Text="ΕΛΕΓΧΟΙ   ΑΝΑΦΟΡΑ   ΚΑΤΑΣΚΕΥΗ EXE"
                               FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Επόμενο βήμα: λειτουργικοί έλεγχοι και stress tests"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="#BDD4E7" Margin="0,0,0,24"/>
                    <Button Style="{StaticResource DiagnosticButton}"
                            Content="ΔΟΚΙΜΗ ΚΟΥΜΠΙΟΥ" Tag="Β — Grayscale"
                            Click="TestButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="3"
                   Text="Σύγκρινε τα γράμματα στις ενότητες Α και Β και κούνησε το ποντίκι πάνω από τα κουμπιά."
                   Foreground="#B8D1E4" FontSize="14"
                   TextWrapping="Wrap" Margin="2,20,0,0"/>
    </Grid>
</Window>
